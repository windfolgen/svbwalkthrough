I233TwoSoft := proc(x,b)
    local U,V,D,invargs,dirargs;
    U:=x*b: V:=(1-x)*(1-b): D:=x-b:
    invargs:=[z=1/x,zz=1/b]: dirargs:=[z=x,zz=b]:
    V*(subs(invargs,I233Cone)/((1-V)*D)+subs(invargs,I233Ctwo)/((1-U-V)*D)
      +subs(dirargs,I233Cthree)/((1-U)*D)+subs(invargs,I233Ediag)/D^2)
end proc:
