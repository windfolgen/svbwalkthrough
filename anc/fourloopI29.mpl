-40*f[3]*I[z,zz/(zz-1),1,1,0,0]:

I29K7Ordinary := proc()
  option remember;
  Convert(I29K7SV,i,[z,zz])
end proc:

I29K7Value := proc(q,b,prec::posint:=20)
  local a,c;
  a:=convert(q,rational,exact): c:=convert(b,rational,exact):
  Evaluate(subs([z=a,zz=c],I29K7Ordinary()),prec)
end proc:

# Upper-sheet onefold for distinct Euclidean points. The sign of d can be
# chosen consistently by conjugation because the kernel is exchange-even.
I29Euclidean := proc(q,b)
 local u,v,d,x,x0,dx,qp,qm,t;
 if evalb(q=b) then
   if evalb(q=0) or evalb(q=1) then error "coincident external points" end if;
   return Limit(subs([z=q+I*t,zz=q-I*t],I29K7SV),t=0,right)/(2*(q-1))
 end if;
 u:=q*b: v:=(1-q)*(1-b): d:=sqrt((1+u-v)^2-4*u):
 x0:=(1-sqrt(v))^2: dx:=sqrt((1+x-v)^2-4*x):
 qp:=(1+x-v+dx)/2: qm:=(1+x-v-dx)/2:
 sqrt(u)/d*Int(subs([z=qp,zz=qm],I29K7SV)/(sqrt(x)*dx),x=x0..u)
end proc:
