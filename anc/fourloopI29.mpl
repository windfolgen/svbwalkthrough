# I29 in the ancillary normalization. Load HyperlogProcedures 0.8 first.
# I[z,...,0] is outermost-first. f[3] denotes zeta(3).
I29K7SV :=
8*I[z,0,0,0,0,1,0,1,0]
-8*I[z,0,0,0,0,1,1,0,0]
+8*I[z,0,0,0,1,0,0,1,0]
