             "DeleteDuplicates"}], ")"}]}], "//", 
          RowBox[{
           RowBox[{"Collect", "[", 
            RowBox[{"#", ",", 
             RowBox[{
              RowBox[{"I4", "[", "_", "]"}], "[", "_", "]"}], ",", "Factor"}],
             "]"}], "&"}]}], ")"}], "//", "DeleteDuplicates"}], ",", 
       RowBox[{"{", 
