Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ComplexitySort", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComplexitySort", "[", 
    RowBox[{"var_", ",", "basis_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "list", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"list", "=", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Numerator", "[", 
             RowBox[{"basis", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"var", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "0", ",", "1"}], "]"}], "]"}], ",", "1"}],
                "]"}], "]"}], "]"}], ",", 
            RowBox[{"var", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "var", "]"}]}], "}"}]}], "]"}], "//", 
        RowBox[{
         RowBox[{"ReverseSortBy", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            RowBox[{"First", ",", "Last"}], "}"}]}], "]"}], "&"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"list", "[", 
