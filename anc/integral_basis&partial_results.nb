                    RowBox[{"I4", "[", "a", "]"}]}], ",", "Infinity"}], "]"}],
                   "&"}], "//", "DeleteDuplicates"}]}], "]"}], "&"}]}], ")"}],
            "/.", "sol1"}], "//", 
