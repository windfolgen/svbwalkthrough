 RowBox[{
  RowBox[{
   RowBox[{"gramsidsys", "=", 
    RowBox[{"GenGramIds", "[", 
     RowBox[{"gramids", ",", "den", ",", "basis4L", ",", "8"}], 
     RowBox[{"(*", 
      RowBox[{"number", " ", "of", " ", "vertices"}], "*)"}], "]"}]}], ";"}], 
  
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "this", " ", "step", " ", "can", " ", "be", " ", "skipped", " ", "since", 
     " ", "it", " ", "has", " ", "already", " ", "been", " ", "runned"}], ",",
