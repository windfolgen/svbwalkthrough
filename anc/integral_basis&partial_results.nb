Cell["\<\
The following functions are used to generate the numerator which compensate \
the conformal weight besides the gram identities generated above\
\>", "Text",
 CellChangeTimes->{{3.992837510919771*^9, 3.992837516358485*^9}, {
  3.992837610422229*^9, 
  3.992837636642763*^9}},ExpressionUUID->"8d777698-6b3e-4413-99cb-\
c228b2611b26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "GenerateGraphs", "]"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "this", " ", "function", " ", "is", " ", "written", " ", "by", " ", 
     "Gemini"}], "-", "3.5", "-", "flash"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GenerateGraphs", "[", "degrees_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"stubs", ",", "pairings", ",", "corePairing"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"1.", " ", "Generate", " ", "stubs", " ", 
       RowBox[{"(", 
        RowBox[{"half", "-", "edges"}], ")"}], " ", "based", " ", "on", " ", 
       "degrees"}], "*)"}], 
     RowBox[{
      RowBox[{"stubs", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "degrees", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"degrees", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Handshake", " ", "lemma", " ", 
        RowBox[{"check", ":", 
         RowBox[{
         "sum", " ", "of", " ", "degrees", " ", "must", " ", "be", " ", 
          "even"}]}]}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OddQ", "[", 
         RowBox[{"Length", "[", "stubs", "]"}], "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "2.", " ", "Recursive", " ", "pairing", " ", "function", " ", "with", 
        " ", "tadpole", " ", "filtering", " ", "and", " ", "memoization"}], 
       "*)"}], 
      RowBox[{
       RowBox[{"corePairing", "[", 
        RowBox[{"{", "}"}], "]"}], "=", 
       RowBox[{"{", 
        RowBox[{"{", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"corePairing", "[", "list_List", "]"}], ":=", 
       RowBox[{
        RowBox[{"corePairing", "[", "list", "]"}], "=", 
        RowBox[{"Join", "@@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"list", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", 
              RowBox[{"list", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", "Nothing", ",", 
             RowBox[{"(*", 
              RowBox[{"Skip", " ", 
               RowBox[{"tadpoles", ":", 
                RowBox[{
                "do", " ", "not", " ", "pair", " ", "a", " ", "vertex", " ", 
                 "with", " ", "itself"}]}]}], "*)"}], 
             RowBox[{
              RowBox[{
               RowBox[{"Prepend", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Sort", "@", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"list", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"list", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "}"}]}]}], "]"}], "&"}],
               "/@", 
              RowBox[{"corePairing", "[", 
               RowBox[{"Delete", "[", 
                RowBox[{"list", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", "1", "}"}], ",", 
                   RowBox[{"{", "i", "}"}]}], "}"}]}], "]"}], "]"}]}]}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", 
             RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}]}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "Generate", " ", "all", " ", "valid", " ", "stub", " ", 
        "matchings"}], "*)"}], 
      RowBox[{"pairings", "=", 
       RowBox[{"corePairing", "[", "stubs", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "4.", " ", "Remove", " ", "isomorphic", " ", "labeled", " ", 
        "multigraphs", " ", "by", " ", "sorting", " ", "and", " ", 
        "unioning"}], "*)"}], 
      RowBox[{"Union", "[", 
       RowBox[{"Sort", "/@", "pairings"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "RemainingP", "]"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "generate", " ", "the", " ", "remaining", " ", "polynomials", " ", "we", 
    " ", "should", " ", "add", " ", "according", " ", "to", " ", "the", " ", 
    "gram", " ", "generated"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RemainingP", "[", 
    RowBox[{"list_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tt", ",", "deg", ",", "dl", ",", "tem"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tt", "=", 
       RowBox[{"Range", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"deg", "=", 
       RowBox[{"n", "-", "5"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"degree", " ", "of", " ", "each", " ", "points"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"dl", "=", 
       RowBox[{"deg", "-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", "list", "]"}], ",", "#"}], "]"}], "&"}], 
          "/@", 
          RowBox[{"Range", "[", "n", "]"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Times", "@@", 
           RowBox[{"x", "@@@", "#"}]}], ")"}], "&"}], "/@", 
        RowBox[{"GenerateGraphs", "[", "dl", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "GenGramIds", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GenGramIds", "[", 
    RowBox[{"gramids_", ",", "den_", ",", "basis_", ",", "n_"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gram", ",", "remainP", ",", "test"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"DistributeDefinitions", "[", 
       RowBox[{"x", ",", "RemainingP", ",", "CanonicalExp", ",", "$dir"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ParallelDo", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<performing for gramid: \>\"", ",", "i"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"gram", "=", 
          RowBox[{
           RowBox[{"Det", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"k", ",", "j"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"gramids", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"gramids", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], 
            "]"}], "//", "Expand"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"remainP", "=", 
          RowBox[{"RemainingP", "[", 
           RowBox[{
            RowBox[{"gramids", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "n"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<totally \>\"", ",", 
           RowBox[{"Length", "[", "remainP", "]"}], ",", 
           "\"\< remaining polynomial generated!\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"$dir", ",", 
              RowBox[{"\"\<fourloopgramid_\>\"", "<>", 
               RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_.m\>\""}]}], 
             "}"}], "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Reap", "[", "\[IndentingNewLine]", 
             RowBox[{"Do", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"Sow", "[", 
                 RowBox[{"CanonicalExp", "[", "\[InvisibleSpace]", 
                  RowBox[{
                   RowBox[{"gram", "*", 
                    RowBox[{"remainP", "[", 
                    RowBox[{"[", "l", "]"}], "]"}], "*", 
                    RowBox[{
                    RowBox[{"x", "[", 
                    RowBox[{"1", ",", "3"}], "]"}], "^", "3"}], "*", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"x", "[", 
                    RowBox[{"2", ",", "4"}], "]"}], "^", "3"}], "/", 
                    "den"}]}], ",", "basis", ",", "I4"}], "]"}], "]"}], ";"}],
                "\[IndentingNewLine]", ",", 
               RowBox[{"{", 
                RowBox[{"l", ",", "1", ",", 
                 RowBox[{"Length", "[", "remainP", "]"}]}], "}"}]}], "]"}], 
             "\[IndentingNewLine]", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "gramids", "]"}]}], "}"}]}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99283748388245*^9, 3.9928375088746557`*^9}, {
  3.992837574151423*^9, 3.992837604776971*^9}, {3.992837639680681*^9, 
  3.9928376620967913`*^9}, {3.9928378212466507`*^9, 3.992837827069323*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"36f7dd89-d3a5-443c-af69-10082cb5b8b0"],

