   RowBox[{"\<\"MaxPrimes\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MaxDegree\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"PrintDebugInfo\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"PolyRecMethod\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"NThreads\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"MinPrimes\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Degrees\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"NeededVars\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"ApplyFunction\"\>", "\[Rule]", "Identity"}], ",", 
   RowBox[{"\<\"VarsPattern\"\>", "\[Rule]", "Automatic"}]}], "}"}]], "Output",\

