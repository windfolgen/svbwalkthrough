                    RowBox[{
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "1", "-", 
                    RowBox[{"Length", "[", "list", "]"}]}], ">", "0"}], ",", 
                    "1", ",", 
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "1"}]}], "]"}], 
                    "]"}], "]"}]}], "]"}]}], "*", "int"}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "[", "a__", "]"}], ":>", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"x", "[", "a", "]"}], "/.", 
