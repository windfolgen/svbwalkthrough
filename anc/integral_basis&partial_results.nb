                    RowBox[{"Rule", "[", 
                    RowBox[{
                    RowBox[{"List", "@@", 
                    RowBox[{"(", 
                    RowBox[{"nl", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "1"}], "]"}], "]"}], 
                    ")"}]}], ",", 
                    RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], "]"}]}]}],
                   ")"}]}], "}"}]}], "//", "Factor"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"g", "=", 
             RowBox[{"(", 
              RowBox[{"List", "@@", 
               RowBox[{"Denominator", "[", "nint", "]"}]}], ")"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"Not", "@", 
               RowBox[{"FreeQ", "[", 
                RowBox[{"g", ",", 
                 RowBox[{"Power", "[", 
                  RowBox[{"_", ",", "2"}], "]"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", "\"\<double pole present!\>\"", "]"}], 
               ";", 
               RowBox[{"Continue", "[", "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"nnl", "=", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"Select", "[", 
                   RowBox[{"g", ",", 
                    RowBox[{
                    RowBox[{"Not", "@", 
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"list", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}],
                   ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "1", ",", 
                    RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"npos", "=", 
                RowBox[{
                 RowBox[{"Position", "[", 
                  RowBox[{"nnl", ",", 
                   RowBox[{"_", "?", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "#", "]"}], "===", "1"}], "&"}], 
                    ")"}]}], ",", "1"}], "]"}], "//", "Flatten"}]}]}]}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"npos", "=!=", 
               RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
