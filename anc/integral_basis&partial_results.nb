      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "z"}], ")"}], "*", "z", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "zz"}], ")"}], "*", "zz", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Import", "[", 
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"$dir", ",", 
                 RowBox[{"\"\<fourloopgramid_\>\"", "<>", 
