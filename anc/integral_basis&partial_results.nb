     " ", "the", " ", "temp", " ", "files", " ", "are", " ", "already", " ", 
     "calculated"}], ",", " ", 
    RowBox[{
    "and", " ", "we", " ", "combine", " ", "them", " ", "into", " ", "the", 
     " ", "following", " ", "sysgram"}], ",", " ", 
    RowBox[{
    "we", " ", "directly", " ", "store", " ", "sysgram", " ", "instead", " ", 
     "of", " ", "these", " ", "intermediate", " ", "files"}]}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9928376702047567`*^9, 3.9928376768545523`*^9}, {
