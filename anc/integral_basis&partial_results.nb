Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Parameters\"\>", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"\<\"IndepVarsOnly\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"MarkAndSweep\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"SparseOutput\"\>", "\[Rule]", "False"}], ",", 
