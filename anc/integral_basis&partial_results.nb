 RowBox[{
  RowBox[{"ClearAll", "[", "boxing", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"boxing", "[", 
    RowBox[{"int_", ",", "olist_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "list", ",", "num", ",", "den", ",", "ll", ",", "nl", ",", "nnl", ",", 
       "pos", ",", "npos", ",", "nint", ",", "nint1", ",", "g", ",", "fac", 
       ",", "result"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"olist", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "===", "List"}], ",", 
        RowBox[{"list", "=", 
         RowBox[{"olist", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"list", "=", "olist"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<the ordering of external legs is \>\"", ",", "list", ",", " ", 
        "\"\< the expression of svmpl is related to this ordering!\>\""}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"num", "=", 
       RowBox[{"Numerator", "[", "int", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"den", "=", 
       RowBox[{"Denominator", "[", "int", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ll", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"List", "@@", 
           RowBox[{"(", 
            RowBox[{"den", "*", "num"}], ")"}]}], ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Power", "[", 
            RowBox[{
             RowBox[{"x", "[", "a__", "]"}], ",", "n_"}], "]"}], ":>", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"x", "[", "a", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}]}], "//",
         "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "ll", "]"}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"nl", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"ll", ",", 
           RowBox[{
            RowBox[{"Not", "@", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"list", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "list", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"nl", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "===", "1"}], "&"}], ")"}]}],
           ",", "1"}], "]"}], "//", "Flatten"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pos", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<none of the vertex can be shrink by boxing!\>\"", 
          "]"}], ";", 
         RowBox[{"Return", "[", "Null", "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", "pos", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"nl", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"pos", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "1"}], "]"}], "]"}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"result", "=", 
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<acting on vertex \>\"", ",", "Bold"}], "]"}], ",", 
              RowBox[{"list", "[", 
               RowBox[{"[", 
                RowBox[{"pos", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"nint", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"nl", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "1"}], "]"}], "]"}], 
                 "*", 
                 RowBox[{"x", "[", 
                  RowBox[{
                   RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
                   RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "1", "-", 
                    RowBox[{"Length", "[", "list", "]"}]}], ">", "0"}], ",", 
                    "1", ",", 
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "+", "1"}]}], "]"}], 
                    "]"}], "]"}]}], "]"}], "*", 
                 RowBox[{
                  RowBox[{"x", "[", 
                   RowBox[{
                    RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
                    RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], "==", "0"}], 
                    ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "]"}], 
                    "]"}], "]"}]}], "]"}], "/", 
                  RowBox[{"x", "[", 
                   RowBox[{
                    RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "1"}], "==", "0"}], 
                    ",", 
                    RowBox[{"-", "1"}], ",", 
                    RowBox[{
                    RowBox[{"pos", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "]"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"If", "[", 
