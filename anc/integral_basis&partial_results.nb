   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Thread", "@", 
             RowBox[{"Equal", "[", 
              RowBox[{"#", ",", "0"}], "]"}]}], ",", 
