Cell[BoxData[{
 RowBox[{
  RowBox[{"sysgram1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"sysgram", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"I4", "[", "a_", "]"}], "[", "b_", "]"}], ":>", 
        RowBox[{
         RowBox[{"I4", "[", "a", "]"}], "[", 
         RowBox[{"o", "[", "b", "]"}], "]"}]}], "}"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "]"}], "->", 
        "o1"}], ",", 
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", "1", ",", "3", ",", "4"}], "}"}], "]"}], "->", 
        "o2"}], ",", 
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}], "]"}], "->", 
        "o3"}], ",", 
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"{", 
          RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}], "]"}], "->", 
        "o4"}], ",", 
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"{", 
          RowBox[{"3", ",", "1", ",", "2", ",", "4"}], "}"}], "]"}], "->", 
        "o5"}], ",", 
       RowBox[{
        RowBox[{"o", "[", 
         RowBox[{"{", 
          RowBox[{"3", ",", "2", ",", "1", ",", "4"}], "}"}], "]"}], "->", 
        "o6"}]}], "}"}]}], "//", "Sort"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sysgram2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"sysgram1", "/.", "sol3f"}], "//", 
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{"#", ",", 
         RowBox[{
          RowBox[{"I4", "[", "_", "]"}], "[", "_", "]"}], ",", "Factor"}], 
        "]"}], "&"}]}], "//", "DeleteDuplicates"}], "//", 
    RowBox[{
     RowBox[{"SortBy", "[", 
      RowBox[{"#", ",", "LeafCount"}], "]"}], "&"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992838543699841*^9, 3.9928385440103703`*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"60d8c351-ba60-41a1-af8a-7fd3bc1b3fad"],

