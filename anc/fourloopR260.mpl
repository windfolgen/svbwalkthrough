   +2*v/(d*(v-1))*pv+2*u*v/(d*(u-v))*cpv
end proc:
R260Ladder := proc(q,qb,j::posint)
 local k;
 add((-1)^k*(2*j-k)!*ln(q*qb)^k*(polylog(2*j-k,q)-polylog(2*j-k,qb))
     /(k!*(j-k)!*j!),k=0..j)/(q-qb)
end proc:
R260SVFromI214 := proc(q,qb,i214,ci214)
 local u,v,w,wb,s,sb,fish;
 u:=q*qb: v:=(1-q)*(1-qb): w:=1-q: wb:=1-qb: s:=q/(q-1): sb:=qb/(qb-1):
 fish:=R260Ladder(q,qb,1)*R260Ladder(q,qb,3)-R260Ladder(q,qb,2)^2/3:
 R260GramM(q,qb)-2*(i214+ci214)
   -subs({z=s,zz=sb},R168SV)-v*subs({z=w,zz=wb},R168SV)
   +u/v*R260Ladder(s,sb,2)^2+v*R260Ladder(w,wb,2)^2-v*(1+u-v)*fish
end proc:
# Euclidean representatives for Im(q)>0, qb=conjugate(q). Continue the onefolds from their regular chamber.
R260SVEuclidean := proc(q,qb)
 R260SVFromI214(q,qb,I214Euclidean(q,qb),I214Euclidean(1/qb,1/q))
end proc: