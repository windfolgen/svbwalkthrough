# For u=z*zz, v=(1-z)*(1-zz), d=z-zz and y^2=(1-u)^2-4*v,
# I214 = v/d*(I214P0+I214Pu/(u-1)+I214Pv/(v-1)+u*Py/y).
# Py is the primitive of I214CA*dlog(A)+I214CM*dlog(M), with Py=0 at the
# regular Euclidean diagonal. Continue the primitive and y on the same sheet.
# A=(1-u+y)/(1-u-y), M=(v+d+y)*(v-d-y)/((v+d-y)*(v-d+y)).
I214Differential:=proc(yvalue)
  local az,ab,mz,mb;
  az:=-(z*zz-2*zz+1)/(z-1): ab:=-(z*zz-2*z+1)/(zz-1):
  mz:=(z*zz+2*zz-3)/(z-1): mb:=-(z*zz+2*z-3)/(zz-1):
  [(I214CA*az+I214CM*mz)/yvalue,(I214CA*ab+I214CM*mb)/yvalue]
end proc:
I214FromPrimitive:=proc(py,yvalue)
  local u,v;u:=z*zz:v:=(1-z)*(1-zz):
  v/(z-zz)*(I214P0+I214Pu/(u-1)+I214Pv/(v-1)+u*py/yvalue)
end proc:
# Exact, unevaluated final integration in the Euclidean ray chamber from zero.
# Take qb=conjugate(q), Im(q)>0 and continue across other chambers from this one.
I214Euclidean:=proc(q,qb)
  local s,ray,disc,ab,py,yt;
  ray:=[z=s*q,zz=s*qb]:
  disc:=(1-z*zz)^2-4*(1-z)*(1-zz):
  ab:=I214Differential(sqrt(disc)):
  py:=Int(subs(ray,q*ab[1]+qb*ab[2]),s=0..1):
  yt:=sqrt(subs([z=q,zz=qb],disc)):
  subs([z=q,zz=qb],I214FromPrimitive(py,yt))
end proc:
